{
  "name": "brainy-elephant-private-esol",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node private-esol/server.js",
    "test:esol": "node tests/esol-course-validation.js && node tests/esol-functional.js && node tests/esol-content.js && node tests/esol-scenarios.js && node tests/esol-billing.js && node tests/esol-server.js && node tests/esol-customer-server.js",
    "dev": "node tools/esol/preview.js",
    "test:browser": "playwright test",
    "test:browser:quick": "playwright test flows.spec.js",
    "test:browser:lessons": "playwright test lessons.spec.js --project=desktop",
    "test:browser:report": "playwright show-report",
    "build:curriculum": "python3 tools/esol/curriculum/build.py"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  },
  "dependencies": {
    "stripe": "23.0.0"
  }
}
